{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MonoCode Companion",
  "version": "0.1.1",
  "identifier": "dev.monocode.companion",
  "build": {
    "devUrl": "http://localhost:1440",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MonoCode Companion",
        "width": 390,
        "height": 844,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "../../../src-tauri/icons/icon.icns"],
    "targets": "all",
    "iOS": {
      "frameworks": ["SystemConfiguration.framework", "Network.framework"]
    },
    "createUpdaterArtifacts": false
  }
}
